# MySQL connection
MYSQL_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8&autoReconnect=true&rewriteBatchedStatements=true&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
DB_USER=root
DB_PASSWORD=your_password_here
